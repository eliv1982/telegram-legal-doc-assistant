# Telegram bot token (get one from @BotFather)
BOT_TOKEN=your_bot_token_here

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# How long to wait for the second message (minutes): an unfinished session is dropped and its files are deleted
SESSION_TIMEOUT_MINUTES=10

# Optional: OpenAI client (the defaults are shown)
# Timeout of one request, seconds
# OPENAI_TIMEOUT_SECONDS=90
# Retries on 429, 5xx and network failures (done by the SDK itself)
# OPENAI_MAX_RETRIES=2

# Optional: models and voice (the defaults are shown)
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TRANSCRIPTION_LANGUAGE=ru
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_ANALYSIS_MODEL=gpt-4o
# OPENAI_REPORT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
