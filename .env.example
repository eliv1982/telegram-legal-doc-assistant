# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Таймаут ожидания второго сообщения (минуты): незавершённая сессия сбрасывается, файлы удаляются
SESSION_TIMEOUT_MINUTES=10

# Формат чек-листа: pdf или png
CHECKLIST_FORMAT=pdf

# Необязательно: клиент OpenAI (значения по умолчанию указаны)
# Тайм-аут одного запроса, секунды
# OPENAI_TIMEOUT_SECONDS=90
# Повторы при 429, 5xx и сетевых сбоях (делает сам SDK)
# OPENAI_MAX_RETRIES=2

# Необязательно: модели и голос (значения по умолчанию указаны)
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TRANSCRIPTION_LANGUAGE=ru
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_ANALYSIS_MODEL=gpt-4o
# OPENAI_REPORT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
